@page
@model AmuraWebsite.Pages.Quote.Motor.ComprehensiveQuoteModel
@{
    ViewData["Title"] = "Comprehensive Motor Insurance — Get a Quote";
    ViewData["Description"] = "Compare live comprehensive motor insurance prices from Amura Insurance Agency's underwriter partners.";
}

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8 reveal">
                <div class="contact-card">
                    <h3 style="font-size:1.15rem; font-weight:700; margin: 0 0 0.2rem;">Comprehensive Motor Quote</h3>
                    <p class="text-muted small mb-3">Enter your vehicle's value and we'll compare live prices from our underwriter partners.</p>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                    }

                    <form method="post" novalidate>
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Input.VehicleValue" class="form-label">Vehicle value (KES)</label>
                                <input asp-for="Input.VehicleValue" class="form-control" type="number" min="10000" step="1000" placeholder="e.g. 1500000" />
                                <span asp-validation-for="Input.VehicleValue" class="text-danger small"></span>
                                <span class="text-muted small">The current market/insured value of your vehicle.</span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-quote btn-lg">Get My Quote &rarr;</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4 reveal">
                <span class="eyebrow">Comprehensive cover</span>
                <h2 class="mt-3 mb-4" style="font-size:1.5rem; font-weight:600;">Full protection</h2>
                <p class="text-muted">Covers damage to your own vehicle as well as third-party liability — compare live prices across our underwriter partners with no obligation.</p>
            </div>
        </div>
    </div>
</section>

@if (Model.Quote is not null && Model.Quote.Options.Count > 0)
{
    <section class="section" style="padding-top:0;">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-8 reveal">
                    <div class="contact-card">
                        <h3 style="font-size:1.15rem; font-weight:700; margin: 0 0 0.2rem;">Your prices</h3>
                        <p class="text-muted small mb-3">
                            @Model.Quote.Options.Count underwriter(s) compared for a vehicle valued at <strong>KES @Model.Input.VehicleValue.ToString("N0")</strong>. Prices below are the annual premium.
                        </p>

                        @foreach (var option in Model.Quote.Options.OrderBy(p => p.TotalPremium))
                        {
                            <div class="mb-3" style="border:1px solid var(--line-on-light); border-radius: var(--radius-md); padding: 1.25rem;">
                                <div class="d-flex justify-content-between align-items-start flex-wrap">
                                    <strong>@option.UnderwriterName</strong>
                                    <div style="font-size:1.4rem; font-weight:700; color: var(--gold-2);">
                                        KES @option.TotalPremium.ToString("N0")
                                    </div>
                                </div>
                                <div class="text-muted small mb-2">
                                    Base premium KES @option.BasePremium.ToString("N0") &middot; Rate @option.RatePercent.ToString("0.####")% &middot; PVT KES @option.PvtAmount.ToString("N0")
                                </div>

                                @{
                                    var benefits = Model.Quote.BenefitsByUnderwriter.TryGetValue(option.UnderwriterId.ToString(), out var uwBenefits)
                                        ? uwBenefits : new List<AmuraWebsite.Services.ComprehensiveBenefitDto>();
                                    var included = benefits.Where(b => b.IsIncludedInBase).ToList();
                                    var addons = benefits.Where(b => !b.IsIncludedInBase).ToList();
                                    var limits = Model.Quote.LiabilityLimitsByUnderwriter.TryGetValue(option.UnderwriterId.ToString(), out var uwLimits)
                                        ? uwLimits : new List<AmuraWebsite.Services.ComprehensiveLiabilityLimitDto>();
                                }

                                @if (included.Count > 0)
                                {
                                    <div class="small mb-1"><strong>Included in base:</strong>
                                        @foreach (var b in included)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis me-1">@b.BenefitName</span>
                                        }
                                    </div>
                                }
                                @if (addons.Count > 0)
                                {
                                    <div class="small mb-1"><strong>Optional add-ons:</strong>
                                        @foreach (var b in addons)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis me-1">
                                                @b.BenefitName@(b.DefaultPrice > 0 ? " (+KES " + b.DefaultPrice.ToString("N0") + ")" : "")
                                            </span>
                                        }
                                    </div>
                                }
                                @if (limits.Count > 0)
                                {
                                    <details class="small text-muted mt-1">
                                        <summary>Coverage limits</summary>
                                        <ul class="mb-0 ps-3 mt-1">
                                            @foreach (var l in limits.OrderBy(l => l.DisplayOrder))
                                            {
                                                <li><strong>@l.LimitName:</strong> @l.LimitValue</li>
                                            }
                                        </ul>
                                    </details>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-4 reveal">
                    <span class="eyebrow">Next steps</span>
                    <h2 class="mt-3 mb-3" style="font-size:1.3rem; font-weight:600;">Like what you see?</h2>
                    <p class="text-muted">Contact us to arrange your cover, or head to <a asp-page="/Quote/Motor">Get a Motor Quote</a> to request a call-back with these prices.</p>
                </div>
            </div>
        </div>
    </section>
}