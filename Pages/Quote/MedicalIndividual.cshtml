@page
@model AmuraWebsite.Pages.Quote.MedicalIndividualModel
@{
    ViewData["Title"] = "Medical Quote — Individual & Family";
    ViewData["Description"] = "Get a quote for individual or family medical cover from Amura Insurance Agency.";
}

<section class="hero" style="padding: 6rem 0 4.5rem;">
    <div class="container hero-content">
        <span class="hero-kicker">Medical — Individual &amp; Family</span>
        <h1 style="font-size:clamp(2rem,4vw,2.8rem); max-width: 20ch;">Get a medical cover quote.</h1>
        <p class="lead">A few details and we'll come back with options that fit.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7 reveal">
                <div class="contact-card">

                    @if (Model.Submitted)
                    {
                        <div class="alert alert-success" role="alert">
                            Thanks — your quote request has been received@(string.IsNullOrEmpty(Model.ReferenceNumber) ? "." : $" (ref. {Model.ReferenceNumber}).") We'll be in touch shortly.
                        </div>
                    }

                    <form method="post" novalidate>
                        <input type="hidden" asp-for="FormToken" />
                        <div style="position:absolute; left:-9999px; opacity:0;" aria-hidden="true">
                            <label for="Input_Website">Leave this field blank</label>
                            <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
                        </div>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.FullName" class="form-label">Full name</label>
                                <input asp-for="Input.FullName" class="form-control" placeholder="Jane Wanjiku" />
                                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Phone" class="form-label">Phone</label>
                                <input asp-for="Input.Phone" class="form-control" placeholder="07xx xxx xxx" />
                                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.Email" class="form-label">Email</label>
                                <input asp-for="Input.Email" class="form-control" placeholder="jane@example.com" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.DateOfBirth" class="form-label">Date of birth</label>
                                <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
                                <span asp-validation-for="Input.DateOfBirth" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Dependents" class="form-label">Dependents to cover</label>
                                <input asp-for="Input.Dependents" class="form-control" type="number" min="0" max="10" />
                                <span asp-validation-for="Input.Dependents" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.CoverLevel" class="form-label">Preferred cover level</label>
                                <select asp-for="Input.CoverLevel" class="form-select">
                                    <option value="Basic">Basic</option>
                                    <option value="Standard" selected>Standard</option>
                                    <option value="Premium">Premium</option>
                                    <option value="Not sure">Not sure — advise me</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.ExistingConditions" class="form-label">Existing conditions (optional)</label>
                                <textarea asp-for="Input.ExistingConditions" class="form-control" rows="3" placeholder="Anything we should know before quoting?"></textarea>
                                <span asp-validation-for="Input.ExistingConditions" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-quote btn-lg mt-4">Get my quote</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-5 reveal">
                <span class="eyebrow">What's covered</span>
                <h2 class="mt-3 mb-4" style="font-size:1.5rem; font-weight:600;">Individual &amp; family medical</h2>
                <p class="text-muted">Inpatient and outpatient cover, with options to add dental, optical and maternity depending on the plan you choose.</p>
            </div>
        </div>
    </div>
</section>
