@page
@model AmuraWebsite.Pages.Quote.MedicalIndividualModel
@{
    ViewData["Title"] = "Medical Quote — Individual & Family";
    ViewData["Description"] = "Get a quote for individual or family medical cover from Amura Insurance Agency.";
}

<section class="hero" style="padding: 6rem 0 4.5rem;">
    <div class="container hero-content">
        <span class="hero-kicker">Medical — Individual &amp; Family</span>
        <h1 style="font-size:clamp(2rem,4vw,2.8rem); max-width: 20ch;">Get a medical cover quote.</h1>
        <p class="lead">A few details and we'll come back with options that fit.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8 reveal">
                <div class="contact-card">

                    @if (Model.Submitted)
                    {
                        <div class="alert alert-success" role="alert">
                            Thanks — your quote request has been received@(string.IsNullOrEmpty(Model.ReferenceNumber) ? "." : $" (ref. {Model.ReferenceNumber}).") We'll be in touch shortly.
                        </div>
                    }

                    <form method="post" novalidate>
                        <input type="hidden" asp-for="FormToken" />
                        <div style="position:absolute; left:-9999px; opacity:0;" aria-hidden="true">
                            <label for="Input_Website">Leave this field blank</label>
                            <input asp-for="Input.Website" tabindex="-1" autocomplete="off" />
                        </div>
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <h3 style="font-size:1.15rem; font-weight:700; margin: 0 0 0.2rem;">Section 1: Your Information</h3>
                        <p class="text-muted small mb-3">Tell us who this cover is for.</p>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.FullName" class="form-label">Full name</label>
                                <input asp-for="Input.FullName" class="form-control" placeholder="Jane Wanjiku" />
                                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.IdNo" class="form-label">National ID / Passport number</label>
                                <input asp-for="Input.IdNo" class="form-control" placeholder="e.g. 33333333" />
                                <span asp-validation-for="Input.IdNo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Phone" class="form-label">Phone</label>
                                <input asp-for="Input.Phone" class="form-control" placeholder="07xx xxx xxx" />
                                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Email" class="form-label">Email</label>
                                <input asp-for="Input.Email" class="form-control" placeholder="jane@example.com" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.DateOfBirth" class="form-label">Your date of birth</label>
                                <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
                                <span asp-validation-for="Input.DateOfBirth" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h3 style="font-size:1.15rem; font-weight:700; margin: 0 0 0.2rem;">Section 2: Dependants to Cover</h3>
                        <p class="text-muted small mb-3">Optional — add a spouse and/or children, or leave rows blank if not needed. Only one spouse can be listed.</p>

                        @{
                            var dependents = new[]
                            {
                                ("Dependent1", Model.Input.Dependent1),
                                ("Dependent2", Model.Input.Dependent2),
                                ("Dependent3", Model.Input.Dependent3),
                                ("Dependent4", Model.Input.Dependent4),
                                ("Dependent5", Model.Input.Dependent5),
                            };
                        }

                        @for (var i = 0; i < dependents.Length; i++)
                        {
                            var prefix = $"Input.{dependents[i].Item1}";
                            <div class="row g-2 mb-2 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label small">Relationship</label>
                                    <select name="@($"{prefix}.Relationship")" class="form-select form-select-sm">
                                        <option value="None" selected="@(dependents[i].Item2.Relationship == "None")">— Not used —</option>
                                        <option value="Spouse" selected="@(dependents[i].Item2.Relationship == "Spouse")">Spouse</option>
                                        <option value="Child" selected="@(dependents[i].Item2.Relationship == "Child")">Child</option>
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label small">Full name</label> 
                                    <input name="@($"{prefix}.FullName")" value="@dependents[i].Item2.FullName" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small">Date of birth</label>
                                    <input name="@($"{prefix}.DateOfBirth")" value="@(dependents[i].Item2.DateOfBirth?.ToString("yyyy-MM-dd"))" type="date" class="form-control form-control-sm" />
                                </div>
                            </div>
                        }

                        <button type="submit" class="btn btn-quote btn-lg mt-4">Get my quote</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4 reveal">
                <span class="eyebrow">What's covered</span>
                <h2 class="mt-3 mb-4" style="font-size:1.5rem; font-weight:600;">Individual &amp; family medical</h2>
                <p class="text-muted">Inpatient and outpatient cover, with options to add dental, optical and maternity depending on the plan you choose.</p>
            </div>
        </div>
    </div>
</section>
