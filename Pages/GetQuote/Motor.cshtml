@page "/get-quote/motor"
@model AmuraWebsite.Pages.GetQuote.MotorModel
@{
    ViewData["Title"] = "Motor Insurance Quote";
    ViewData["Description"] = "Request a motor insurance quote from Amura Insurance Agency.";
}

<section class="hero" style="padding: 6rem 0 4.5rem;">
    <div class="container hero-content">
        <span class="hero-kicker">Motor Insurance</span>
        <h1 style="font-size:clamp(2rem,4.2vw,3rem); max-width: 20ch;">Tell us about the vehicle.</h1>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7 reveal">
                <div class="contact-card">

                    @if (Model.Submitted)
                    {
                        <div class="alert alert-success" role="alert">
                            Thanks — your quote request has been received. We'll be in touch shortly.
                        </div>
                    }
                    else
                    {
                        <form method="post" novalidate id="motorForm">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <partial name="_Honeypot" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Input.FullName" class="form-label">Full name</label>
                                    <input asp-for="Input.FullName" class="form-control" />
                                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Phone" class="form-label">Phone</label>
                                    <input asp-for="Input.Phone" class="form-control" />
                                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Input.Email" class="form-label">Email</label>
                                    <input asp-for="Input.Email" class="form-control" />
                                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Input.VehicleCategory" class="form-label">Vehicle category</label>
                                    <select asp-for="Input.VehicleCategory" class="form-select" id="vehicleCategory">
                                        <option value="">Choose...</option>
                                        <option value="Private">Private</option>
                                        <option value="PSV">PSV (Bus / Matatu)</option>
                                        <option value="Commercial">Commercial</option>
                                        <option value="Institution">Institution</option>
                                    </select>
                                    <span asp-validation-for="Input.VehicleCategory" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.CoverType" class="form-label">Cover type</label>
                                    <select asp-for="Input.CoverType" class="form-select" id="coverType">
                                        <option value="">Choose...</option>
                                        <option value="ThirdParty">Third Party</option>
                                        <option value="Comprehensive">Comprehensive</option>
                                    </select>
                                    <span asp-validation-for="Input.CoverType" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Input.RegistrationNumber" class="form-label">Registration number (optional if new)</label>
                                    <input asp-for="Input.RegistrationNumber" class="form-control" placeholder="KDA 123A" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.MakeModel" class="form-label">Make &amp; model</label>
                                    <input asp-for="Input.MakeModel" class="form-control" placeholder="e.g. Toyota Hiace" />
                                    <span asp-validation-for="Input.MakeModel" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.YearOfManufacture" class="form-label">Year of manufacture</label>
                                    <input asp-for="Input.YearOfManufacture" type="number" min="1980" max="2100" class="form-control" />
                                    <span asp-validation-for="Input.YearOfManufacture" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Period" class="form-label">Cover period</label>
                                    <select asp-for="Input.Period" class="form-select">
                                        <option value="">Choose...</option>
                                        <option value="Annual">Annual</option>
                                        <option value="Short Term">Short term</option>
                                    </select>
                                    <span asp-validation-for="Input.Period" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 d-none" id="sittingCapacityGroup">
                                    <label asp-for="Input.SittingCapacity" class="form-label">Sitting capacity</label>
                                    <input asp-for="Input.SittingCapacity" type="number" min="1" max="200" class="form-control" />
                                    <span asp-validation-for="Input.SittingCapacity" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 d-none" id="tonnageGroup">
                                    <label asp-for="Input.Tonnage" class="form-label">Tonnage</label>
                                    <input asp-for="Input.Tonnage" type="number" step="0.1" min="0.1" class="form-control" />
                                    <span asp-validation-for="Input.Tonnage" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 d-none" id="estimatedValueGroup">
                                    <label asp-for="Input.EstimatedValue" class="form-label">Estimated vehicle value (KES)</label>
                                    <input asp-for="Input.EstimatedValue" type="number" min="0" step="1000" class="form-control" />
                                    <span asp-validation-for="Input.EstimatedValue" class="text-danger small"></span>
                                </div>
                                <div class="col-12 d-none" id="comprehensiveDetailsGroup">
                                    <label asp-for="Input.ComprehensiveDetails" class="form-label">Anything else for comprehensive cover? (optional)</label>
                                    <textarea asp-for="Input.ComprehensiveDetails" class="form-control" rows="3" placeholder="e.g. excess protection, windscreen cover, named drivers"></textarea>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-quote btn-lg mt-4">Request quote</button>
                        </form>
                    }
                </div>
            </div>

            <div class="col-lg-5 reveal">
                <span class="eyebrow">Motor Insurance</span>
                <h2 class="mt-3 mb-4" style="font-size:1.6rem; font-weight:600;">What's covered</h2>
                <p class="text-muted">Third Party or Comprehensive cover for private, PSV, commercial and institutional vehicles.</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var categorySelect = document.getElementById('vehicleCategory');
            var coverSelect = document.getElementById('coverType');
            var sittingGroup = document.getElementById('sittingCapacityGroup');
            var tonnageGroup = document.getElementById('tonnageGroup');
            var valueGroup = document.getElementById('estimatedValueGroup');
            var compDetailsGroup = document.getElementById('comprehensiveDetailsGroup');

            function toggle(el, show) {
                el.classList.toggle('d-none', !show);
            }

            function sync() {
                var category = categorySelect.value;
                var cover = coverSelect.value;

                toggle(sittingGroup, category === 'PSV');
                toggle(tonnageGroup, category === 'Commercial' || category === 'Institution');
                toggle(valueGroup, cover === 'Comprehensive');
                toggle(compDetailsGroup, cover === 'Comprehensive');
            }

            categorySelect.addEventListener('change', sync);
            coverSelect.addEventListener('change', sync);
            sync();
        })();
    </script>
}
