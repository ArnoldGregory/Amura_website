@page "/get-quote/proposal"
@model AmuraWebsite.Pages.GetQuote.ProposalModel
@{
    ViewData["Title"] = "Professional Indemnity — Proposal";
    ViewData["Description"] = "Complete your Professional Indemnity proposal with Amura Insurance Agency.";
}

<section class="hero" style="padding: 6rem 0 4.5rem;">
    <div class="container hero-content">
        <span class="hero-kicker">Professional Indemnity</span>
        <h1 style="font-size:clamp(2rem,4.2vw,3rem); max-width: 20ch;">Just a few more details.</h1>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7 reveal">
                <div class="contact-card">

                    @if (Model.Submitted)
                    {
                        <div class="alert alert-success" role="alert">
                            Thanks — your proposal has been received. We'll be in touch shortly.
                        </div>
                    }
                    else
                    {
                        <form method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <partial name="_Honeypot" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Input.FullName" class="form-label">Full name</label>
                                    <input asp-for="Input.FullName" class="form-control" />
                                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Phone" class="form-label">Phone</label>
                                    <input asp-for="Input.Phone" class="form-control" />
                                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Email" class="form-label">Email</label>
                                    <input asp-for="Input.Email" class="form-control" />
                                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Profession" class="form-label">Profession / business type</label>
                                    <input asp-for="Input.Profession" class="form-control" />
                                    <span asp-validation-for="Input.Profession" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Input.AdditionalDetails" class="form-label">Tell us about your work (optional for now)</label>
                                    <textarea asp-for="Input.AdditionalDetails" class="form-control" rows="4" placeholder="e.g. annual turnover, years in practice, prior claims"></textarea>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-quote btn-lg mt-4">Submit proposal</button>
                        </form>
                    }
                </div>
            </div>

            <div class="col-lg-5 reveal">
                <span class="eyebrow">Proposal</span>
                <h2 class="mt-3 mb-4" style="font-size:1.6rem; font-weight:600;">What happens next</h2>
                <p class="text-muted">We'll review your proposal and come back with cover options and pricing.</p>
            </div>
        </div>
    </div>
</section>
