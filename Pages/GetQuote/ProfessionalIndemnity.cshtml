@page "/get-quote/professional-indemnity"
@model AmuraWebsite.Pages.GetQuote.ProfessionalIndemnityModel
@{
    ViewData["Title"] = "Professional Indemnity — Start a Proposal";
    ViewData["Description"] = "Start a Professional Indemnity cover proposal with Amura Insurance Agency.";
}

<section class="hero" style="padding: 6rem 0 4.5rem;">
    <div class="container hero-content">
        <span class="hero-kicker">Professional Indemnity</span>
        <h1 style="font-size:clamp(2rem,4.2vw,3rem); max-width: 22ch;">Let's start your proposal.</h1>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7 reveal">
                <div class="contact-card">
                    <form method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <partial name="_Honeypot" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.FullName" class="form-label">Full name</label>
                                <input asp-for="Input.FullName" class="form-control" placeholder="Jane Wanjiku" />
                                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Phone" class="form-label">Phone</label>
                                <input asp-for="Input.Phone" class="form-control" placeholder="07xx xxx xxx" />
                                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Email" class="form-label">Email</label>
                                <input asp-for="Input.Email" class="form-control" placeholder="jane@example.com" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Profession" class="form-label">Profession / business type</label>
                                <input asp-for="Input.Profession" class="form-control" placeholder="e.g. Architect, Consultant, Law firm" />
                                <span asp-validation-for="Input.Profession" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-quote btn-lg mt-4">Continue to proposal</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-5 reveal">
                <span class="eyebrow">Professional Indemnity</span>
                <h2 class="mt-3 mb-4" style="font-size:1.6rem; font-weight:600;">How this works</h2>
                <p class="text-muted">Cover against claims of negligence or error in the professional advice or services you provide. We'll take a few details here, then a short proposal form to finish up.</p>
            </div>
        </div>
    </div>
</section>
