@page "/get-quote/travel"
@model AmuraWebsite.Pages.GetQuote.TravelModel
@{
    ViewData["Title"] = "Travel Insurance Quote";
    ViewData["Description"] = "Request a travel insurance quote from Amura Insurance Agency.";
}

<section class="hero" style="padding: 6rem 0 4.5rem;">
    <div class="container hero-content">
        <span class="hero-kicker">Travel Insurance</span>
        <h1 style="font-size:clamp(2rem,4.2vw,3rem); max-width: 20ch;">Tell us about your trip.</h1>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7 reveal">
                <div class="contact-card">

                    @if (Model.Submitted)
                    {
                        <div class="alert alert-success" role="alert">
                            Thanks — your quote request has been received. We'll be in touch shortly.
                        </div>
                    }
                    else
                    {
                        <form method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <partial name="_Honeypot" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Input.FullName" class="form-label">Full name</label>
                                    <input asp-for="Input.FullName" class="form-control" />
                                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Phone" class="form-label">Phone</label>
                                    <input asp-for="Input.Phone" class="form-control" />
                                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Input.Email" class="form-label">Email</label>
                                    <input asp-for="Input.Email" class="form-control" />
                                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.TripType" class="form-label">Cover type</label>
                                    <select asp-for="Input.TripType" class="form-select">
                                        <option value="">Choose...</option>
                                        <option value="Single trip">Single trip</option>
                                        <option value="Frequent traveller">Frequent traveller (annual)</option>
                                    </select>
                                    <span asp-validation-for="Input.TripType" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Destination" class="form-label">Destination</label>
                                    <input asp-for="Input.Destination" class="form-control" placeholder="e.g. UK, Schengen, East Africa" />
                                    <span asp-validation-for="Input.Destination" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.DepartureDate" class="form-label">Departure date</label>
                                    <input asp-for="Input.DepartureDate" type="date" class="form-control" />
                                    <span asp-validation-for="Input.DepartureDate" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.ReturnDate" class="form-label">Return date</label>
                                    <input asp-for="Input.ReturnDate" type="date" class="form-control" />
                                    <span asp-validation-for="Input.ReturnDate" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Input.AdditionalDetails" class="form-label">Anything else we should know? (optional)</label>
                                    <textarea asp-for="Input.AdditionalDetails" class="form-control" rows="4"></textarea>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-quote btn-lg mt-4">Request quote</button>
                        </form>
                    }
                </div>
            </div>

            <div class="col-lg-5 reveal">
                <span class="eyebrow">Travel Insurance</span>
                <h2 class="mt-3 mb-4" style="font-size:1.6rem; font-weight:600;">What's covered</h2>
                <p class="text-muted">Medical emergencies, trip cancellation, lost luggage and delays — for single trips or frequent travel.</p>
            </div>
        </div>
    </div>
</section>
