@page "/get-quote/domestic"
@model AmuraWebsite.Pages.GetQuote.DomesticModel
@{
    ViewData["Title"] = "Domestic Insurance Quote";
    ViewData["Description"] = "Request a home and contents insurance quote from Amura Insurance Agency.";
}

<section class="hero" style="padding: 6rem 0 4.5rem;">
    <div class="container hero-content">
        <span class="hero-kicker">Domestic Insurance</span>
        <h1 style="font-size:clamp(2rem,4.2vw,3rem); max-width: 20ch;">Protect your home.</h1>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7 reveal">
                <div class="contact-card">

                    @if (Model.Submitted)
                    {
                        <div class="alert alert-success" role="alert">
                            Thanks — your quote request has been received. We'll be in touch shortly.
                        </div>
                    }
                    else
                    {
                        <form method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <partial name="_Honeypot" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Input.FullName" class="form-label">Full name</label>
                                    <input asp-for="Input.FullName" class="form-control" />
                                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Phone" class="form-label">Phone</label>
                                    <input asp-for="Input.Phone" class="form-control" />
                                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Input.Email" class="form-label">Email</label>
                                    <input asp-for="Input.Email" class="form-control" />
                                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Input.PropertyAddress" class="form-label">Property address</label>
                                    <input asp-for="Input.PropertyAddress" class="form-control" />
                                    <span asp-validation-for="Input.PropertyAddress" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.CoverFor" class="form-label">Cover for</label>
                                    <select asp-for="Input.CoverFor" class="form-select">
                                        <option value="">Choose...</option>
                                        <option value="Building">Building only</option>
                                        <option value="Contents">Contents only</option>
                                        <option value="Both">Building and contents</option>
                                    </select>
                                    <span asp-validation-for="Input.CoverFor" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.SumInsured" class="form-label">Estimated sum insured (KES)</label>
                                    <input asp-for="Input.SumInsured" type="number" min="0" step="1000" class="form-control" />
                                    <span asp-validation-for="Input.SumInsured" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Input.AdditionalDetails" class="form-label">Anything else we should know? (optional)</label>
                                    <textarea asp-for="Input.AdditionalDetails" class="form-control" rows="4"></textarea>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-quote btn-lg mt-4">Request quote</button>
                        </form>
                    }
                </div>
            </div>

            <div class="col-lg-5 reveal">
                <span class="eyebrow">Domestic Insurance</span>
                <h2 class="mt-3 mb-4" style="font-size:1.6rem; font-weight:600;">What's covered</h2>
                <p class="text-muted">Cover for your home and its contents against fire, theft, weather damage and other everyday risks.</p>
            </div>
        </div>
    </div>
</section>
