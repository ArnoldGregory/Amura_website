@page "/get-quote/medical-corporate"
@model AmuraWebsite.Pages.GetQuote.MedicalCorporateModel
@{
    ViewData["Title"] = "Medical Cover Quote — Corporate";
    ViewData["Description"] = "Request a group medical cover quote for your team from Amura Insurance Agency.";
}

<section class="hero" style="padding: 6rem 0 4.5rem;">
    <div class="container hero-content">
        <span class="hero-kicker">Medical — Corporate</span>
        <h1 style="font-size:clamp(2rem,4.2vw,3rem); max-width: 20ch;">Cover for your whole team.</h1>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7 reveal">
                <div class="contact-card">

                    @if (Model.Submitted)
                    {
                        <div class="alert alert-success" role="alert">
                            Thanks — your quote request has been received. We'll be in touch shortly.
                        </div>
                    }
                    else
                    {
                        <form method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            <partial name="_Honeypot" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Input.ContactName" class="form-label">Contact person</label>
                                    <input asp-for="Input.ContactName" class="form-control" placeholder="Jane Wanjiku" />
                                    <span asp-validation-for="Input.ContactName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.CompanyName" class="form-label">Company name</label>
                                    <input asp-for="Input.CompanyName" class="form-control" />
                                    <span asp-validation-for="Input.CompanyName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Email" class="form-label">Email</label>
                                    <input asp-for="Input.Email" class="form-control" placeholder="jane@company.co.ke" />
                                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.Phone" class="form-label">Phone</label>
                                    <input asp-for="Input.Phone" class="form-control" placeholder="07xx xxx xxx" />
                                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Input.EmployeeCount" class="form-label">Number of employees to cover</label>
                                    <input asp-for="Input.EmployeeCount" type="number" min="1" class="form-control" />
                                    <span asp-validation-for="Input.EmployeeCount" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Input.AdditionalDetails" class="form-label">Anything else we should know? (optional)</label>
                                    <textarea asp-for="Input.AdditionalDetails" class="form-control" rows="4" placeholder="e.g. desired benefit tiers, current provider, renewal date"></textarea>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-quote btn-lg mt-4">Request quote</button>
                        </form>
                    }
                </div>
            </div>

            <div class="col-lg-5 reveal">
                <span class="eyebrow">Medical — Corporate</span>
                <h2 class="mt-3 mb-4" style="font-size:1.6rem; font-weight:600;">What's covered</h2>
                <p class="text-muted">Group medical cover for your team, with tiered benefit options and a single renewal date for the whole scheme.</p>
            </div>
        </div>
    </div>
</section>
