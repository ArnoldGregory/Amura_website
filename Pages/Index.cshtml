@page
@model AmuraWebsite.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "Amura Insurance Agency — Medical, Motor, Travel, Domestic and Professional Indemnity cover for individuals, families and businesses across Kenya.";
}

<!-- ============================= HERO ============================= -->
<section class="hero">
    <div class="container hero-content">
        <div class="row align-items-center g-5">
            <div class="col-lg-8">
                <span class="hero-kicker">Amura Insurance Agency</span>
                <h1>
                    Cover that fits your life,<br />
                    not the other way around.
                </h1>
                <p class="lead">
                    <!-- PENDING: replace with confirmed copy from Amura (Task 5 — Content integration) -->
                    Medical, Motor, Travel, Domestic and Professional Indemnity cover —
                    guided by people who take the time to get your quote right the first time.
                </p>
                <div class="hero-actions d-flex flex-wrap gap-3">
                    <a asp-page="/Services" class="btn btn-quote btn-lg">Get a Quote</a>
                    <a asp-page="/Services" class="btn btn-ghost-light btn-lg">Explore Products</a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-flex justify-content-center">
                <div class="seal">
                    <div class="seal-inner">AMURA<br />INSURANCE<br />AGENCY</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================= TRUST STRIP ========================= -->
<div class="trust-strip">
    <div class="container">
        <div class="row gy-3">
            <div class="col-6 col-md-3">
                <div class="trust-item"><strong>5</strong>Product lines</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="trust-item"><strong>Licensed</strong>Motor cover via DMVIC</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="trust-item"><strong>Agent</strong>Network across Kenya</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="trust-item"><strong>Digital</strong>Certificates &amp; renewals</div>
            </div>
        </div>
    </div>
</div>

<!-- ========================== PRODUCTS ========================== -->
<section class="section section-cream">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-7 reveal">
                <span class="eyebrow">What we cover</span>
                <h2 class="mt-3" style="font-size:clamp(1.8rem,3.5vw,2.6rem); font-weight:600;">
                    Five products, one straightforward process.
                </h2>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4 reveal">
                <div class="product-card">
                    <div class="product-icon">M</div>
                    <h3>Medical — Individual &amp; Family</h3>
                    <p>Inpatient and outpatient cover sized to your household.</p>
                    <a asp-page="/Services">Get a quote &rarr;</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="product-card">
                    <div class="product-icon">C</div>
                    <h3>Medical — Corporate</h3>
                    <p>Group medical cover for teams of any size.</p>
                    <a asp-page="/Services">Get a quote &rarr;</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="product-card">
                    <div class="product-icon">P</div>
                    <h3>Professional Indemnity</h3>
                    <p>Protection against claims arising from professional advice or services.</p>
                    <a asp-page="/Services">Get a quote &rarr;</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="product-card">
                    <div class="product-icon">T</div>
                    <h3>Travel Insurance</h3>
                    <p>Cover for medical emergencies, delays and lost baggage abroad.</p>
                    <a asp-page="/Services">Get a quote &rarr;</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="product-card">
                    <div class="product-icon">D</div>
                    <h3>Domestic Insurance</h3>
                    <p>Cover for your home and its contents against loss or damage.</p>
                    <a asp-page="/Services">Get a quote &rarr;</a>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="product-card">
                    <div class="product-icon">✓</div>
                    <h3>Not sure what you need?</h3>
                    <p>Tell us a bit about your situation and we'll point you to the right cover.</p>
                    <a asp-page="/Contact">Talk to us &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ======================== ABOUT PREVIEW ======================== -->
<section class="section section-dark">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 reveal">
                <!-- PENDING: swap for real photography from Amura (hero/office imagery) -->
                <div class="media-placeholder">Image placeholder — Amura office / team photography pending</div>
            </div>
            <div class="col-lg-6 reveal">
                <span class="eyebrow">Why Amura</span>
                <h2 class="mt-3" style="font-size:clamp(1.8rem,3.5vw,2.4rem); font-weight:600;">
                    Insurance, explained in plain language.
                </h2>
                <p class="mt-3">
                    <!-- PENDING: replace with confirmed About copy from Amura -->
                    We work with individuals, families and businesses across Kenya to find
                    cover that actually matches how they live and work — then stay on hand
                    when it's time to make a claim.
                </p>
                <a asp-page="/About" class="btn btn-ghost-light mt-2">More about us</a>
            </div>
        </div>
    </div>
</section>

<!-- ============================= CTA ============================= -->
<section class="section">
    <div class="container">
        <div class="cta-band reveal">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <h2 style="font-size:clamp(1.6rem,3vw,2.2rem);">Ready to see your quote?</h2>
                    <p class="mb-0" style="color:rgba(11,11,12,0.75);">Takes a few minutes. No commitment.</p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a asp-page="/Services" class="btn btn-dark-pill btn-lg">Get a Quote</a>
                </div>
            </div>
        </div>
    </div>
</section>
